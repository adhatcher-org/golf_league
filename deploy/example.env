# PLACEHOLDERS ONLY — this is not a real configuration.
#
# It exists so the compose template can be validated without any real value:
#
#   docker compose --env-file deploy/example.env -f deploy/compose.example.yml config --quiet
#
# Never fill this file in and commit it. Real values are kept privately on the
# Unraid host (see docs/deployment.md, "Values the operator supplies privately").

# A pinned tag or digest of the released image; this host does not exist.
GOLF_LEAGUE_IMAGE=registry.example.invalid/golf_league:0.0.0-placeholder
# The host directory mounted at /app/data.
GOLF_LEAGUE_DATA_DIR=/path/to/golf-league-data
# Owner of that directory; the image user is 1000:1000.
PUID=1000
PGID=1000
# Replace privately with a long random value.
SESSION_SECRET=replace-me
EXTERNAL_BASE_URL=https://golfleague.example.invalid
# First boot only; leave empty here.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# The Docker network SWAG is attached to.
PROXY_NETWORK=proxy-network-placeholder
# SWAG's fixed address on that network. 192.0.2.0/24 is reserved for documentation.
SWAG_IP=192.0.2.10
